(ns rfqops.phase
  "Phase 0->3 staged rollout for the RFQ coordination actor.

    Phase 0  read-only          -- no writes, still governor-gated.
    Phase 1  assisted-intake    -- RFQs may be opened, every write
                                   needs human approval.
    Phase 2  assisted-quoting   -- adds quote intake, still
                                   approval-gated.
    Phase 3  supervised auto    -- governor-clean, high-confidence
                                   `:open-rfq` and `:receive-quote`
                                   may auto-commit.

  `:record-award` and `:flag-rfq-concern` are deliberately ABSENT
  from every phase's `:auto` set, INCLUDING phase 3.

  ## Intake may auto-commit; awarding may not

  Opening states a need and receiving files an answer — recording
  that someone asked, or that someone answered, asserts nothing
  about who is right or who wins. The safety is that the RFQ
  transition table bounds what is expressible and the governor
  re-derives RFQ/quote validity from stored state.

  `:record-award` is the opposite: it moves money expectations
  downstream, so it always passes a human. `rfqops.governor`'s own
  `always-escalate-ops` enforces the same invariant independently."
  (:require [rfqops.governor :as governor]))

(def read-ops #{})
(def write-ops governor/allowed-ops)

;; NOTE the invariant: `:record-award` and `:flag-rfq-concern` are
;; members of `write-ops` (governor-gated like any write) but are NEVER
;; members of any phase's `:auto` set below. Do not add them there.
(def phases
  "phase -> {:label .. :writes <ops allowed to write> :auto <ops allowed
  to auto-commit when governor-clean>}."
  {0 {:label "read-only"        :writes #{}                :auto #{}}
   1 {:label "assisted-intake"  :writes #{:open-rfq}        :auto #{}}
   2 {:label "assisted-quoting" :writes #{:open-rfq :receive-quote} :auto #{}}
   3 {:label "supervised-auto"  :writes write-ops
      :auto #{:open-rfq :receive-quote}}})

(def default-phase 3)

(defn gate
  "Adjust a governor disposition for the rollout phase. Returns
  {:disposition kw :reason kw|nil}."
  [phase {:keys [op]} governor-disposition]
  (let [{:keys [writes auto]} (get phases phase (get phases default-phase))]
    (cond
      (= :hold governor-disposition)       {:disposition :hold :reason nil}
      (contains? read-ops op)              {:disposition governor-disposition :reason nil}
      (not (contains? writes op))          {:disposition :hold :reason :phase-disabled}
      (and (= :commit governor-disposition)
           (not (contains? auto op)))      {:disposition :escalate :reason :phase-approval}
      :else                                {:disposition governor-disposition :reason nil})))

(defn verdict->disposition
  "Map an RFQGovernor verdict to a base disposition before the phase
  gate."
  [verdict]
  (cond (:hard? verdict) :hold
        (:escalate? verdict) :escalate
        :else :commit))
